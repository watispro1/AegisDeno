DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Guild-scoped registration for local testing. Leave empty for global (production) commands.
DISCORD_TEST_GUILD_ID=
BETA_GUILD_ID=1554633956966539385
# Comma-separated guild IDs to clear on startup when registering globally.
# Prevents a command appearing twice if it was ever registered to a test guild.
DISCORD_CLEAR_GUILD_IDS=
# MongoDB connection string, e.g. mongodb+srv://user:password@cluster/db
MONGO_URI=
BOT_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# json (one JSON object per line, no colours) or pretty. Defaults to json when NODE_ENV=production.
LOG_FORMAT=
# Comma-separated user IDs allowed to run /developer and /sync.
# When this and DISCORD_OWNER_ID are both empty, the fallback owner 1320058519642177668 is used.
BOT_OWNER_IDS=
# Note: .env is only read when NODE_ENV is not production. At startup every variable is
# validated and the bot exits with one error listing all missing or invalid values.
SUPPORT_SERVER_URL=
# One-time "Run /help to get started" message when Aegis joins a server. Set to off to disable.
JOIN_WELCOME=
# Optional email shown on the terms and privacy pages. Leave empty to point people to GitHub issues.
CONTACT_EMAIL=
BOT_INVITE_URL=
# Public origin of the website, used for canonical URLs, Open Graph tags, and the sitemap.
# Leave empty locally; set it in production (no trailing slash), e.g. https://aegis.example.com
SITE_URL=
# HTTP port for the website server. Defaults to 3000, which is what Fly.io exposes.
PORT=3000

# Web dashboard (/dashboard). Off unless both secrets are set.
# Client secret from Developer Portal -> OAuth2. DISCORD_APPLICATION_ID is the client ID.
DISCORD_CLIENT_SECRET=
# Signs session cookies and CSRF tokens. Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
# Must match a redirect added in Developer Portal -> OAuth2 -> Redirects.
# Defaults to https://aegisdeno.fly.dev/dashboard/callback. Locally: http://localhost:3000/dashboard/callback
DASHBOARD_REDIRECT_URI=
# Dashboard rate-limit counters: memory (default, one process) or mongo (shared across instances).
# RATE_LIMIT_STORE=memory

# Top.gg Integration & Webhook Auth
TOPGG_TOKEN=
TOPGG_WEBHOOK_AUTH=

# Aegis Premium is sold ONLY as a Discord in-app subscription (Discord SKU).
# Copy from Discord Developer Portal -> Monetization -> SKUs (a USD 5.00/month guild subscription).
# Required to sell and to grant Premium: with it (and DISCORD_APPLICATION_ID) the site shows
# "Subscribe in Discord" -> https://discord.com/application-directory/<APP_ID>/store/<SKU_ID>
# and /premium shows Discord's native Subscribe button. Without it every surface says
# "Coming soon on Discord" and no entitlement grants Premium (nor does any other SKU).
DISCORD_PREMIUM_SKU_ID=

# Web checkout is OFF: Premium can't be bought on the website. This is the code constant
# WEB_CHECKOUT_ENABLED = false in src/config/stripe.ts, deliberately not an env variable,
# so setting the STRIPE_* values below never re-enables checkout
# (POST /dashboard/<id>/premium/checkout answers 403 {"error":"web_checkout_disabled"}).
#
# Stripe, only for subscriptions bought on the website before Premium moved to Discord:
# the webhook keeps them in sync and the buyer can open Stripe's billing portal to manage
# or cancel. The webhook answers 503 without STRIPE_WEBHOOK_SECRET.
# Server-side secret key (sk_test_... for test mode, sk_live_... for production).
STRIPE_SECRET_KEY=
# Publishable key (pk_test_... for test mode, pk_live_... for production).
STRIPE_PUBLISHABLE_KEY=
# The existing recurring price ID for Aegis Premium ($5/month), e.g. price_1ABC...
STRIPE_PRICE_ID=
# Webhook signing secret for endpoint https://<site>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=

# AegisDB (secondary store; MongoDB stays the source of truth).
# One shared secret for the bot and the embedded TypeScript engine's HTTP API.
# Required outside development (BOT_ENV/NODE_ENV=development or test); without it AegisDB does not start.
# Generate with: openssl rand -hex 32
AEGIS_BACKEND_SECRET=
# Leave empty (normal): the bot opens the AegisDB engine in its own process and calls it directly.
# Set it only to use an external AegisDB over HTTP instead (e.g. http://other-host:4000); then no local engine is opened.
AEGIS_BACKEND_URL=
# Port of the embedded engine's optional HTTP API on 127.0.0.1 (for outside tools; the bot does not use it). Defaults to 4000.
AEGIS_DB_PORT=
# Data directory for WAL + snapshots. Defaults to ./data/aegis-db; the Docker image sets /data/aegis-db (Fly volume).
AEGIS_DB_PATH=
