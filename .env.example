DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Guild-scoped registration for local testing. Leave empty for global (production) commands.
DISCORD_TEST_GUILD_ID=
BETA_GUILD_ID=1554633956966539385
# Comma-separated guild IDs to clear on startup when registering globally.
# Prevents a command appearing twice if it was ever registered to a test guild.
DISCORD_CLEAR_GUILD_IDS=
# MongoDB connection string, e.g. mongodb+srv://user:password@cluster/db
MONGO_URI=
BOT_ENV=development
LOG_LEVEL=info
SUPPORT_SERVER_URL=
# Optional email shown on the terms and privacy pages. Leave empty to point people to GitHub issues.
CONTACT_EMAIL=
BOT_INVITE_URL=
# Public origin of the website, used for canonical URLs, Open Graph tags, and the sitemap.
# Leave empty locally; set it in production (no trailing slash), e.g. https://aegis.example.com
SITE_URL=
# HTTP port for the website server. Defaults to 3000, which is what Fly.io exposes.
PORT=3000

# Web dashboard (/dashboard). Off unless both secrets are set.
# Client secret from Developer Portal -> OAuth2. DISCORD_APPLICATION_ID is the client ID.
DISCORD_CLIENT_SECRET=
# Signs session cookies and CSRF tokens. Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=
# Must match a redirect added in Developer Portal -> OAuth2 -> Redirects.
# Defaults to https://aegisdeno.fly.dev/dashboard/callback. Locally: http://localhost:3000/dashboard/callback
DASHBOARD_REDIRECT_URI=

# Top.gg Integration & Webhook Auth
TOPGG_TOKEN=
TOPGG_WEBHOOK_AUTH=

