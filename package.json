{
  "name": "aegisdeno",
  "version": "3.7.0",
  "description": "Aegis - Discord moderation bot",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run build && npx tsx scripts/smoke-web.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "preview:site": "tsx scripts/preview-site.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "deploy": "tsx scripts/deploy-commands.ts",
    "deploy:clean-guilds": "tsx scripts/deploy-commands.ts --clean-guilds"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mongoose": "^9.10.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
