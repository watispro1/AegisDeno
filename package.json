{
  "name": "aegisdeno",
  "version": "3.15.0",
  "description": "Aegis - Discord moderation bot",
  "main": "dist/main.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:unit && npm run build && npx tsx scripts/smoke-web.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && tsx --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.ts && tsx scripts/coverage-summary.ts",
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "preview:site": "tsx scripts/preview-site.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "check:versions": "tsx scripts/check-versions.ts",
    "lint:install": "npm ci --prefix tools/lint --no-audit --no-fund",
    "lint": "node --max-old-space-size=6144 tools/lint/node_modules/eslint/bin/eslint.js .",
    "format:check": "node tools/lint/node_modules/prettier/bin/prettier.cjs --check .",
    "deploy": "tsx scripts/deploy-commands.ts",
    "deploy:clean-guilds": "tsx scripts/deploy-commands.ts --clean-guilds"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
